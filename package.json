{
  "name": "solid-js-modal",
  "version": "1.2.0",
  "description": "{{desc_of_lib}}",
  "license": "MIT",
  "author": "funny-family",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funny-family/solid-js-modal.git"
  },
  "homepage": "https://github.com/funny-family/solid-js-modal#readme",
  "bugs": {
    "url": "https://github.com/funny-family/solid-js-modal/issues"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "solid",
    "solid js",
    "solid-js-modal",
    "modal",
    "modal window",
    "dialog",
    "dialog window",
    "html"
  ],
  "scripts": {
    "dev": "vite serve dev",
    "build": "node ./scripts/build.js",
    "build:watch": "tsup --watch",
    "test": "concurrently pnpm:test:*",
    "test:client": "vitest",
    "test:ssr": "pnpm run test:client --mode ssr",
    "prepublishOnly": "pnpm build",
    "format": "prettier --ignore-path .gitignore -w \"src/**/*.{js,ts,json,css,tsx,jsx}\" \"dev/**/*.{js,ts,json,css,tsx,jsx}\"",
    "lint": "concurrently pnpm:lint:*",
    "lint:code": "eslint --ignore-path .gitignore --max-warnings 0 src/**/*.{js,ts,tsx,jsx}",
    "lint:types": "tsc --noEmit",
    "update-deps": "pnpm up -Li"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.3",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^8.56.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "jsdom": "^24.0.0",
    "prettier": "3.0.0",
    "rollup": "^4.53.5",
    "rollup-plugin-import-css": "^4.1.2",
    "rollup-preset-solid": "^3.0.0",
    "solid-js": "^1.8.17",
    "tsup": "^8.0.2",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-solid": "^2.11.9",
    "vitest": "^1.6.0"
  }
}
